    { "id": "area-listings", "kind": "feed", "accepts": "listings" },
    { "id": "area-sold", "kind": "feed", "accepts": "listings" },
    { "id": "home-finder", "kind": "form", "form": "home-finder" },
    { "id": "questions", "kind": "feed", "accepts": "faqs" }
   ]
  },
  "agent-in-area": {
