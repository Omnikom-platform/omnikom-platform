{
 "version": 1,
 "name": "fixture-audit",
 "what": "The fixture manifest of the omnikom seo tests: one step per state a run can end in (RUN, SKIPPED, BLOCKED, WAITING, PARTIAL, FAILED) and the steps that depend on them.",
 "steps": [
  {"id": "fx-ok", "module": "alpha", "what": "exit 0 with evidence", "script": "scripts/ok.mjs", "args": ["--id", "fx-ok", "--out", "{pewp}/fx-ok.json"], "inputs": [], "outputs": ["{pewp}/fx-ok.json"], "dependsOn": [], "needsBrowser": "none", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "none", "pace": null, "timeoutMinutes": 1, "evidence": ["{pewp}/fx-ok.json"]},
  {"id": "fx-read", "module": "alpha", "what": "reads what fx-ok wrote", "script": "scripts/ok.mjs", "args": ["--id", "fx-read", "--read", "{pewp}/fx-ok.json", "--out", "{pewp}/fx-read.json"], "inputs": ["{pewp}/fx-ok.json"], "outputs": ["{pewp}/fx-read.json"], "dependsOn": ["fx-ok"], "needsBrowser": "none", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "none", "pace": null, "timeoutMinutes": 1, "evidence": ["{pewp}/fx-read.json"]},
  {"id": "fx-blocked", "module": "beta", "what": "exit 3 with a BLOCKED line", "script": "scripts/blocked.mjs", "args": ["--id", "fx-blocked"], "inputs": [], "outputs": ["{pewp}/fx-blocked.json"], "dependsOn": [], "needsBrowser": "none", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "none", "pace": null, "timeoutMinutes": 1, "evidence": ["{pewp}/fx-blocked.json"]},
  {"id": "fx-skipped", "module": "beta", "what": "exit 4 with a SKIPPED line", "script": "scripts/skipped.mjs", "args": ["--id", "fx-skipped"], "inputs": [], "outputs": ["{pewp}/fx-skipped.json"], "dependsOn": [], "needsBrowser": "none", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "none", "pace": null, "timeoutMinutes": 1, "evidence": ["{pewp}/fx-skipped.json"]},
  {"id": "fx-partial", "module": "beta", "what": "exit 4 that this step's manifest entry says is partial", "script": "scripts/partial.mjs", "args": ["--id", "fx-partial", "--out", "{pewp}/fx-partial.json"], "inputs": [], "outputs": ["{pewp}/fx-partial.json"], "dependsOn": [], "needsBrowser": "none", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "none", "pace": null, "timeoutMinutes": 1, "exit": {"4": "partial: what was read is kept; run again to continue"}, "evidence": ["{pewp}/fx-partial.json"]},
  {"id": "fx-fail", "module": "gamma", "what": "exit 1", "script": "scripts/fail.mjs", "args": ["--id", "fx-fail"], "inputs": [], "outputs": ["{pewp}/fx-fail.json"], "dependsOn": [], "needsBrowser": "none", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "none", "pace": null, "timeoutMinutes": 1, "evidence": ["{pewp}/fx-fail.json"]},
  {"id": "fx-wait", "module": "gamma", "what": "waits for the owner's browser", "script": null, "args": [], "inputs": ["{pewp}/fx-ok.json"], "outputs": ["{pewp}/captures/fx-wait.json"], "dependsOn": ["fx-ok"], "needsBrowser": "owner", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "third-party:example.net", "pace": "one page at least 45 s apart", "timeoutMinutes": 0, "evidence": ["{pewp}/captures/fx-wait.json"], "brief": "Open {url} in the owner's browser and save what the page says to {work}/note, then to the captures folder."},
  {"id": "fx-after", "module": "gamma", "what": "uses what the waiting step produced", "script": "scripts/ok.mjs", "args": ["--id", "fx-after", "--read", "{pewp}/captures/fx-wait.json", "--out", "{pewp}/fx-after.json"], "inputs": ["{pewp}/captures/fx-wait.json"], "outputs": ["{pewp}/fx-after.json"], "dependsOn": ["fx-wait"], "needsBrowser": "none", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "none", "pace": null, "timeoutMinutes": 1, "evidence": ["{pewp}/fx-after.json"]},
  {"id": "fx-after-fail", "module": "gamma", "what": "depends on a step that fails", "script": "scripts/ok.mjs", "args": ["--id", "fx-after-fail", "--out", "{pewp}/fx-after-fail.json"], "inputs": [], "outputs": ["{pewp}/fx-after-fail.json"], "dependsOn": ["fx-fail"], "needsBrowser": "none", "needsAi": false, "needsPerson": false, "needsKeys": [], "heavy": false, "hits": "none", "pace": null, "timeoutMinutes": 1, "evidence": ["{pewp}/fx-after-fail.json"]}
 ]
}
