{ "version": 1, "site": "demo-site", "source": { "dir": "site-src" },
  "build": { "live": "node site-src/launch.mjs --out {out}", "proofs": [ { "id": "full", "cmd": "node site-src/launch.mjs --config site-src/proof/full.json --out {out}" }, { "id": "empty", "cmd": "node site-src/launch.mjs --out {out}", "env": { "DEMO_EMPTY": "all" } } ] },
  "serve": "node site-src/proof/serve-local.mjs {dir} {port}",
  "pages": { "from": "list", "list": ["home", "about/", "contact-us/", "areas/north/"], "extra": ["404.html"], "samples": { "deep": "areas/north/" } },
  "widths": [360, 390, 430], "wide": 1366, "motion": { "on": "?motion=on", "off": "?motion=off" }, "menu": { "kind": "sheet+mega" },
  "selectors": { "header": ".hdr", "bar": ".hdr-bar", "logo": ".hdr-logo img", "footerBar": ".ftr-bar", "legalLinks": ".ftr-bar a, .consent a", "sections": "main section, footer",
    "menuButton": "[data-menu]", "menuSheet": "[data-sheet]", "mega": "[data-mega=\"{id}\"]", "pageBar": "[data-pbar]" },
  "forms": [ { "flow": "contact", "page": "contact-us/", "selector": "form[data-lead=\"contact\"]", "sheetTab": "Contact" } ],
  "vendored": [ { "name": "demo-map", "version": "1.9.4", "dir": "assets/vendor/demo-map-1.9.4/", "pages": ["areas/north/"], "minWidth": 600 } ],
  "claims": "claims.json", "redirects": { "rules": "_redirects", "old": "old-addresses.txt", "waitOwner": 2 },
  "lead": { "function": "functions/lead.js", "tests": "node lead/tests/run-all.mjs", "testFlow": "contact" },
  "deploy": { "project": "demo-site", "tokenKey": "CLOUDFLARE_API_TOKEN_DEMO", "host": "demo-site.example.test" },
  "own": [ { "id": "site-phone", "cmd": "node tools/phone-use.mjs --live {live} --full {full}", "pass": "PHONE USE PASS", "heavy": true, "browser": true } ] }
