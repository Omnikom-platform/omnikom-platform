{
 "version": 1,
 "name": "client-audit",
 "what": "Every step of a full client audit of a live site (audit-live), in one list that start.mjs and `omnikom seo run` both read. Steps marked needsBrowser owner, needsAi or needsPerson are never run by a script: the runner lists them as WAITING with their brief, an agent or the owner writes their outputs, and the next resume picks them up.",
 "conventions": {
  "exit": {
   "0": "ok",
   "2": "usage",
   "3": "BLOCKED",
   "4": "SKIPPED"
  },
  "lastLine": "A step that exits 3 prints `BLOCKED: <what> | unblocks: <what would>`; one that exits 4 prints `SKIPPED: <reason>`. The runner quotes that line and never invents a reason.",
  "done": "exit 0 in the run log AND every evidence path exists, is not empty, and was written after the step started; an input newer than the evidence makes the step stale.",
  "hits": "Two steps that hit the same host never run at the same time. pace is informational: the script enforces it.",
  "scriptPaths": "Relative to the skill folder. `repo:` means relative to the Omnikom repository root."
 },
 "vars": {
  "url": "the live site, as given",
  "client": "the client slug (clients/<slug>/ in the Omnikom repo)",
  "host": "the url's hostname without www.",
  "skill": "the skill folder",
  "data": "the run's data folder; until row R3 the skill folder",
  "runDir": "{data}/site-checks/{host}",
  "pewp": "{runDir}/.pewp",
  "work": "{runDir}/work"
 },
 "steps": [
  {
   "id": "doctor",
   "module": "setup",
   "what": "which free sources and keys are connected; the latest Common Crawl release",
   "script": "scripts/doctor.mjs",
   "args": [
    "{url}",
    "--cwd",
    "{skill}",
    "--json"
   ],
   "inputs": [],
   "outputs": [
    "{pewp}/doctor.json"
   ],
   "dependsOn": [],
   "needsBrowser": "none",
   "needsAi": false,
   "needsPerson": false,
   "needsKeys": [],
   "heavy": false,
   "hits": "third-party:commoncrawl",
   "pace": null,
   "timeoutMinutes": 5,
   "evidence": [
    "{pewp}/doctor.json"
   ],
   "kind": "time-sensitive",
   "maxAgeDays": 1
  },
  {
   "id": "vantage",
   "module": "visibility",
   "what": "US vantage (Sacramento) verified before any capture",
   "script": "scripts/vantage.mjs",
   "args": [
    "status",
    "--json",
    "--pewp",
    "{pewp}"
   ],
   "inputs": [],
   "outputs": [
    "{pewp}/vantage.json"
   ],
   "dependsOn": [
    "doctor"
   ],
   "needsBrowser": "headless",
   "needsAi": false,
   "needsPerson": false,
   "needsKeys": [],
   "heavy": true,
   "hits": "third-party:ip-geo",
   "pace": null,
   "timeoutMinutes": 2,
   "evidence": [
    "{pewp}/vantage.json"
   ],
   "kind": "time-sensitive",
   "maxAgeDays": 1
  },
  {
   "id": "snapshot",
   "module": "technical",
   "what": "polite snapshot of the site, raw HTML and rendered in real Chrome, phone speed in the lab (a snapshot younger than 7 days is reused; either way snapshots/latest.json says which one this run handed on)",
   "script": "scripts/live-target.mjs",
   "args": [
    "{url}",
    "--cwd",
    "{skill}"
   ],
   "inputs": [],
   "outputs": [
    "{runDir}/snapshots/"
   ],
   "dependsOn": [
    "doctor"
   ],
   "needsBrowser": "headless",
   "needsAi": false,
   "needsPerson": false,
   "needsKeys": [],
   "heavy": true,
   "hits": "client",
   "pace": "1 request per 4 s, robots.txt obeyed, a 429 waits 90 s once then stops",
   "timeoutMinutes": 150,
   "evidence": [
    "{runDir}/snapshots/latest.json"
   ],
   "kind": "time-sensitive",
   "maxAgeDays": 7
  },
  {
   "id": "psi",
   "module": "technical",
   "what": "Google's PageSpeed test, phone and desktop, three runs each: every run's raw answer is kept and the median is recorded (medianOf says how many runs it is a median of)",
   "script": "scripts/psi.mjs",
   "args": [
    "{url}",
    "--cwd",
    "{skill}",
    "--strategy",
    "mobile,desktop",
    "--runs",
    "3",
    "--gap-ms",
    "2000"
   ],
   "inputs": [],
   "outputs": [
    "{pewp}/psi/"
   ],
   "dependsOn": [
    "doctor"
   ],
   "needsBrowser": "none",
   "needsAi": false,
   "needsPerson": false,
   "needsKeys": [
    "PSI_API_KEY"
   ],
   "heavy": false,
   "hits": "third-party:pagespeedonline.googleapis.com",
   "pace": "2 s between calls, 31 s between two runs of the same page (Google may answer a repeat within about 30 s from one analysis)",
   "timeoutMinutes": 15,
   "evidence": [
    "{pewp}/psi/*.json"
   ],
   "kind": "time-sensitive",
   "maxAgeDays": 7
  },
  {
   "id": "crux",
   "module": "technical",
   "what": "real-visitor speed from the Chrome UX Report, for the page and its origin on phones and desktops; NO DATA (too little traffic) is a result, not a failure",
   "script": "scripts/crux.mjs",
   "args": [
    "{url}",
    "--cwd",
    "{skill}"
   ],
   "inputs": [],
   "outputs": [
    "{pewp}/crux/"
   ],
   "dependsOn": [
    "doctor"
   ],
   "needsBrowser": "none",
   "needsAi": false,
   "needsPerson": false,
   "needsKeys": [
    "CRUX_API_KEY"
   ],
   "heavy": false,
   "hits": "third-party:chromeuxreport.googleapis.com",
   "pace": "1 s between calls",
   "timeoutMinutes": 5,
   "evidence": [
    "{pewp}/crux/*.json"
   ],
   "kind": "time-sensitive",
   "maxAgeDays": 28
  },
  {
   "id": "checker",
