    "snapshot"
   ],
   "needsBrowser": "none",
   "needsAi": true,
   "needsPerson": false,
   "needsKeys": [],
   "heavy": true,
   "hits": "none",
   "pace": null,
   "timeoutMinutes": 120,
   "evidence": [
    "{work}/checker/.checks/causes.json"
   ],
   "kind": "time-sensitive",
   "maxAgeDays": 7,
   "brief": "Copy the newest snapshot folder to {work}/checker, then run ONE coordinator agent on it exactly as SKILL.md 'The checker' says, with the repo root = that copy."
  },
