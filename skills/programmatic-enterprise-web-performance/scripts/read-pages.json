{
 "pace": {
  "tabsAtOnce": 1,
  "afterLoadSeconds": 8,
  "gapSeconds": 45,
  "maxPagesPerRun": 30
 },
 "bing": {
  "selectors": {
   "result": "#b_results > li.b_algo",
   "link": "h2 a",
   "title": "h2",
   "related": ".b_rs a"
  }
 },
 "directories": {
  "yellowpages.com": {
   "search": "https://www.yellowpages.com/search?search_terms={name}&geo_location_terms={city}",
   "selectors": {
    "result": "div.search-results.organic > div.result",
    "name": "a.business-name",
    "address": "div.adr",
    "phone": "div.phones",
    "link": "a.business-name"
   }
  },
  "bbb.org": {
   "search": "https://www.bbb.org/search?find_country=USA&find_text={name}&find_loc={city}",
   "selectors": {
    "result": "div.search-results div.card.result-card",
    "name": "h3",
    "address": ".result-business-info p",
    "phone": "a[href^=\"tel:\"]",
    "link": "h3 a"
   }
  },
  "mapquest.com": {
   "search": "https://www.mapquest.com/search?query={name}%20{city}",
   "selectors": "NOT SET"
  },
  "yelp.com": {
   "search": "https://www.yelp.com/search?find_desc={name}&find_loc={city}",
   "selectors": "NOT SET"
  }
 }
}
