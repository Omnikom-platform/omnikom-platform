{
 "openapi": "3.1.2",
 "info": {
  "title": "Omnikom Platform functions",
  "version": "1.0.0-draft",
  "description": "Supabase Edge Functions and the per-site form endpoint. User-facing functions take the user's Supabase JWT (bearerAuth, verify_jwt on). Machine-called functions run with verify_jwt = false (supabase/config.toml) and verify their own credential in code first (jobToken, runnerSecret, siteSignature, cronSecret). The database enforces the tenancy wall (02-BACKEND.md). Error bodies use the Problem schema with contract/store codes (07-SPECS.md)."
 },
 "servers": [
  {
   "url": "https://{projectRef}.supabase.co/functions/v1",
   "description": "projectRef is the Supabase project reference id (not the project name)",
   "variables": {
    "projectRef": {
     "default": "your-project-ref"
    }
   }
  }
 ],
 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "Supabase JWT"
   },
   "runnerSecret": {
    "type": "apiKey",
    "in": "header",
    "name": "X-Runner-Signature",
    "description": "Runner key. Header value t=<unix seconds>,v1=<hex HMAC-SHA256 of \"t\\nMETHOD\\npath?query\\nbody\">, accepted for 300 s (supabase/functions/_shared/signature.ts); checked in code (verify_jwt = false). The runner is trusted (ADR 0011)"
   },
   "siteSignature": {
    "type": "apiKey",
    "in": "header",
    "name": "X-Site-Signature",
    "description": "That site's own signing key. Header value t=<unix seconds>,v1=<hex HMAC-SHA256 of \"t\\nMETHOD\\npath?query\\nbody\">, accepted for 300 s (supabase/functions/_shared/signature.ts); checked in code (verify_jwt = false)"
   },
   "cronSecret": {
    "type": "apiKey",
    "in": "header",
    "name": "X-Internal-Secret",
    "description": "internal cron secret read from Vault by pg_cron; checked in code (verify_jwt = false)"
   }
  },
  "schemas": {
   "Problem": {
    "type": "object",
    "required": [
     "code",
     "message"
    ],
    "properties": {
     "code": {
      "type": "string",
      "description": "e.g. S-OWN-ONLY, S-LOCKED, VALIDATION"
     },
     "message": {
      "type": "string",
      "description": "plain words for the client"
     },
     "problems": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/FieldProblem"
      }
     }
    }
   },
   "FieldProblem": {
    "type": "object",
    "required": [
     "code",
     "path",
     "msg"
    ],
    "properties": {
     "code": {
      "type": "string",
      "description": "I-* or C-* code"
     },
     "path": {
      "type": "string"
     },
     "msg": {
      "type": "string"
     }
    }
   },
   "SaveRequest": {
    "type": "object",
    "required": [
     "workspace",
     "collection",
     "data"
    ],
    "properties": {
     "workspace": {
      "type": "string",
      "format": "uuid"
     },
     "collection": {
      "type": "string"
     },
     "row": {
      "type": [
       "string",
       "null"
      ],
      "format": "uuid",
      "description": "null creates a row"
     },
     "data": {
      "type": "object"
     },
     "signOff": {
      "type": "object",
      "required": [
       "by",
       "ref"
      ],
      "properties": {
       "by": {
        "type": "string"
       },
       "ref": {
        "type": "string"
       }
      },
      "description": "staff only, when a locked field changes"
     }
    }
   },
   "SaveResponse": {
    "type": "object",
    "required": [
     "row",
     "version"
    ],
    "properties": {
     "row": {
      "type": "string",
      "format": "uuid"
     },
     "version": {
      "type": "integer"
     }
    }
   },
   "PublishRequest": {
    "type": "object",
    "required": [
     "site",
     "rows",
     "versions"
    ],
    "properties": {
     "site": {
      "type": "string",
      "format": "uuid",
      "description": "the site to rebuild (a workspace may have more than one)"
     },
     "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "format": "uuid"
      }
     },
     "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "integer"
      },
      "description": "the version of each row that was validated; the job ships exactly these (dry run 2, N4)"
     }
    }
   },
   "PublishResponse": {
    "type": "object",
    "required": [
     "job",
     "state"
    ],
    "properties": {
     "job": {
      "type": "string",
      "format": "uuid"
     },
     "state": {
      "$ref": "#/components/schemas/JobState"
     },
     "dispatched": {
      "type": "boolean",
      "description": "false when the build did not reach GitHub (no dispatch token, GitHub refused or unreachable): the job stays queued and the reaper fails it after 24 hours; never a silent success"
     },
     "reason": {
      "type": [
       "string",
       "null"
      ],
      "description": "why dispatched is false: no dispatch token, no repository configured, github <status>, github unreachable"
     }
    },
    "description": "a job holding a snapshot of exact versions; nothing goes live until the job is done"
   },
   "JobState": {
    "type": "string",
    "enum": [
     "queued",
     "building",
     "gating",
     "deploying",
     "done",
     "failed"
    ]
   },
   "UploadStartRequest": {
    "type": "object",
    "required": [
     "workspace",
     "filename",
     "bytes",
     "mime"
    ],
    "properties": {
     "workspace": {
      "type": "string",
      "format": "uuid"
     },
     "filename": {
      "type": "string"
     },
     "bytes": {
      "type": "integer",
      "maximum": 26214400
     },
     "mime": {
      "type": "string",
      "enum": [
       "image/jpeg",
       "image/png",
       "image/webp",
       "image/heic",
       "application/pdf"
      ]
     }
    }
   },
   "UploadStartResponse": {
    "type": "object",
    "required": [
     "media",
     "uploadUrl",
     "path"
    ],
    "properties": {
     "media": {
      "type": "string",
      "format": "uuid"
     },
     "uploadUrl": {
      "type": "string"
     },
     "path": {
      "type": "string",
      "description": "<workspace_id>/<uuid>.<ext>"
     }
    }
   },
   "UploadFinishRequest": {
    "type": "object",
    "required": [
     "media",
     "rightsConfirmed"
    ],
    "properties": {
     "media": {
      "type": "string",
      "format": "uuid"
     },
     "rightsConfirmed": {
      "type": "boolean"
     },
     "alt": {
      "type": "string",
      "maxLength": 150
     }
    }
   },
   "Media": {
    "type": "object",
    "required": [
     "id",
     "path",
     "width",
     "height",
     "exifStripped",
     "rightsConfirmed",
     "processed"
    ],
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "path": {
      "type": "string"
     },
     "width": {
      "type": "integer"
     },
     "height": {
      "type": "integer"
     },
     "exifStripped": {
      "type": "boolean"
     },
     "rightsConfirmed": {
      "type": "boolean"
     },
     "sizes": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "processed": {
      "type": "boolean",
      "description": "false until the media processor (build runner) has made sizes and stripped EXIF"
     }
    }
   },
   "Export": {
    "type": "object",
    "description": "Everything one publish job needs, as one document (factory/README.md section 1). A rerun of the same job returns the same snapshot and rows. The runner holds the account deploy token itself (02-BACKEND section 8); no token travels in this document.",
    "required": [
     "schema",
     "job",
     "site",
     "workspace",
     "contract",
     "rows",
     "media"
    ],
    "properties": {
     "schema": {
      "type": "string",
      "enum": [
       "omnikom-export/1"
      ],
      "description": "the factory refuses any other value"
     },
     "job": {
      "type": "object",
      "required": [
       "id",
       "site_id",
       "workspace_id",
       "snapshot",
       "created_at"
      ],
      "properties": {
       "id": {
        "type": "string",
        "format": "uuid"
       },
       "site_id": {
        "type": "string",
        "format": "uuid"
       },
       "workspace_id": {
        "type": "string",
        "format": "uuid"
       },
       "snapshot": {
        "type": "object",
        "additionalProperties": {
         "type": "integer"
        },
        "description": "{ row_id: version } the build ships; a rerun ships the same"
       },
       "created_at": {
        "type": "string",
        "format": "date-time"
       }
      }
     },
     "site": {
      "type": "object",
      "required": [
       "id",
       "deploy_target",
       "preview_host",
       "state"
      ],
      "properties": {
       "id": {
        "type": "string",
        "format": "uuid",
        "description": "the runner refuses if this differs from client_payload.site_id"
       },
       "deploy_target": {
        "type": "string",
        "description": "the Cloudflare Pages project name"
       },
       "preview_host": {
        "type": "string"
       },
       "domain": {
        "type": [
         "string",
         "null"
        ]
       },
       "state": {
        "type": "string",
        "enum": [
         "preview",
         "live",
         "paused"
        ]
       }
      }
     },
     "workspace": {
      "type": "object",
      "required": [
       "id",
       "slug",
       "name",
       "industry"
      ],
      "properties": {
       "id": {
        "type": "string",
        "format": "uuid"
       },
       "slug": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "industry": {
        "type": "string"
       }
      }
     },
     "contract": {
      "type": "object",
      "description": "the resolved site contract (contracts/README.md): the active site_contracts.resolved"
     },
     "rows": {
      "type": "array",
      "description": "exactly the frozen snapshot",
      "items": {
       "type": "object",
       "required": [
        "id",
        "collection",
        "version",
        "data",
        "at"
       ],
       "properties": {
        "id": {
         "type": "string",
         "format": "uuid"
        },
        "collection": {
         "type": "string"
        },
        "version": {
         "type": "integer"
        },
        "data": {
         "type": "object"
        },
        "at": {
         "type": "string",
         "format": "date-time"
        }
       }
      }
     },
     "media": {
      "type": "array",
      "items": {
       "$ref": "#/components/schemas/ExportMedia"
      }
     }
    }
   },
   "JobCallback": {
    "type": "object",
    "required": [
     "job",
     "state"
    ],
    "properties": {
     "job": {
      "type": "string",
      "format": "uuid"
     },
     "state": {
      "$ref": "#/components/schemas/JobState"
     },
     "gateReport": {
      "type": "object",
      "description": "per gate: pass/fail, findings in plain words; at most 64 KiB (413 beyond)"
     },
     "deployId": {
      "type": "string"
     },
     "error": {
      "type": "string"
     }
    },
    "description": "state is one of building | gating | deploying | done | failed (a queued or unknown state is 400). The database decides whether the change is legal (409 S-JOB-STATE)."
   },
   "LeadRequest": {
    "type": "object",
    "required": [
     "form",
     "page",
     "consentText"
    ],
    "properties": {
     "form": {
      "type": "string"
     },
     "page": {
      "type": "string"
     },
     "name": {
      "type": "string",
      "maxLength": 120
     },
     "email": {
      "type": "string",
      "format": "email"
     },
     "phone": {
      "type": "string"
     },
     "answers": {
      "type": "object"
     },
     "consentText": {
      "type": "string",
      "minLength": 1
     },
     "hp": {
      "type": "string",
      "description": "honeypot; must be empty"
     },
     "flow": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "Optional. Which journey on the site produced this lead (a hero tab, a calculator, a landing flow). A lower-case slug, not a closed list, because one procedure serves every industry (DECISIONS 3, 14). Real-estate example (ELEV8): home-value, home-finder, sell, cash-offer, contact. Another industry names its own flows. Checking the value against the site contract is UNPROVEN (not built). Different from form, which is the contract form id.",
      "examples": [
       "home-value",
       "home-finder",
       "sell",
       "cash-offer",
       "contact"
      ]
     },
     "cta": {
      "type": "string",
      "maxLength": 120,
      "description": "Optional. The label of the button or link the visitor used to start the form."
     },
     "assignee": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Optional. Slug of the team row the visitor asked for (for example from an agent profile page). The server checks it against that workspace's team rows and ignores an unknown slug (UNPROVEN, not built)."
     },
     "marketingConsent": {
      "type": "object",
      "required": [
       "given",
       "text"
      ],
      "additionalProperties": false,
      "description": "Optional. Consent to marketing messages, kept separate from consentText (permission to contact the visitor about this request). given is false when the box was left empty; text is the exact wording shown next to the box.",
      "properties": {
       "given": {
        "type": "boolean"
       },
       "text": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "idempotencyKey": {
      "type": "string",
      "format": "uuid",
      "description": "Optional. Made by the form when it loads and reused on every retry of the same submission, so a retry cannot store the lead twice. Deduplication on the server is UNPROVEN (not built)."
     }
    }
   },
   "LeadAccepted": {
    "type": "object",
    "required": [
     "ok"
    ],
    "properties": {
     "ok": {
      "type": "boolean"
     }
    }
   },
   "LeadUpdateRequest": {
    "type": "object",
    "required": [
     "lead"
    ],
    "properties": {
     "lead": {
      "type": "string",
      "format": "uuid"
     },
     "status": {
      "type": "string",
      "enum": [
       "new",
       "contacted",
       "qualified",
       "closed",
       "spam"
      ]
     },
     "owner": {
      "type": "string",
      "format": "uuid",
      "description": "a team row of the workspace; a member cannot hand a lead to someone else (403 S-OWN-ONLY)"
     },
     "note": {
      "type": "string",
      "maxLength": 2000
     },
     "unassign": {
      "type": "boolean",
      "description": "true takes the lead off its owner"
     }
    },
    "description": "every field but lead is optional; each change writes its own event on the lead timeline (service.lead_update)"
   },
   "AddLeadRequest": {
    "type": "object",
    "required": [
     "site",
     "consentText"
    ],
    "properties": {
     "site": {
      "type": "string",
      "format": "uuid"
     },
     "name": {
      "type": "string",
      "maxLength": 120
     },
     "email": {
      "type": "string",
      "format": "email",
      "maxLength": 320
     },
     "phone": {
      "type": "string",
      "maxLength": 40
     },
     "answers": {
      "type": "object"
     },
     "consentText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "the wording the person agreed to, as said or shown; it goes on the consent ledger"
     },
     "form": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "default manual"
     },
     "owner": {
      "type": "string",
      "format": "uuid",
      "description": "a team row of the workspace; ignored for a member: their own lead lands on their own team row"
     }
    }
   },
   "AddLeadResponse": {
    "type": "object",
    "required": [
     "lead"
    ],
    "properties": {
     "lead": {
      "type": "string",
      "format": "uuid"
     }
    }
   },
   "UploadFinishResponse": {
    "type": "object",
    "required": [
     "media",
     "processed",
     "dispatched"
    ],
    "properties": {
     "media": {
      "type": "string",
      "format": "uuid"
     },
     "processed": {
      "type": "boolean",
      "description": "false until the runner calls media-process-callback"
     },
     "dispatched": {
      "type": "boolean",
      "description": "false when the media job did not reach GitHub (no token, GitHub refused); reason says why"
     },
     "reason": {
      "type": "string"
     }
    }
   },
   "ExportMedia": {
    "type": "object",
    "description": "One PROCESSED photo of the workspace (an unprocessed one is left out). `path` is the widest WebP derivative slot that exists (2400 if the original is at least 2400 px wide, else 1600 if at least 1600, else 800, which always exists), never the original upload (the original keeps its GPS data); `url` is a signed download URL for that derivative (1 hour).",
    "required": [
     "id",
     "path",
     "original_path",
     "processed",
     "exif_stripped",
     "rights_confirmed",
     "url"
    ],
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "path": {
      "type": "string",
      "description": "<upload path without extension>-<slot>.webp with slot 2400, 1600 or 800, inside <workspace id>/"
     },
     "original_path": {
      "type": "string",
      "description": "storage path of the upload; information only, never signed or served"
     },
     "width": {
      "type": [
       "integer",
       "null"
      ],
      "description": "of the original after its orientation was applied"
     },
     "height": {
      "type": [
       "integer",
       "null"
      ]
     },
     "processed": {
      "type": "boolean"
     },
     "exif_stripped": {
      "type": "boolean"
     },
     "rights_confirmed": {
      "type": "boolean"
     },
     "url": {
      "type": [
       "string",
       "null"
      ],
      "description": "signed download URL for `path`, valid 1 hour; null when Storage would not sign it (then `error` is \"sign failed\" and the runner fails the build if the file is referenced)"
     },
     "error": {
      "type": "string",
      "enum": [
       "sign failed"
      ]
     }
    }
   },
   "MediaExport": {
    "type": "object",
    "description": "Where one uploaded file is and where the runner puts its sizes. Every URL is signed (Storage, secret key) and the secret key never leaves the function.",
    "required": [
     "id",
     "workspace_id",
     "path",
     "processed",
     "url",
     "uploads"
    ],
    "properties": {
     "id": {
      "type": "string",
      "format": "uuid"
     },
     "workspace_id": {
      "type": "string",
      "format": "uuid"
     },
     "path": {
      "type": "string",
      "description": "storage path of the original upload, <workspace id>/<uuid>.<ext>"
     },
     "processed": {
      "type": "boolean"
     },
     "url": {
      "type": "string",
      "description": "signed download URL of the original, valid 1 hour"
     },
     "uploads": {
      "type": "object",
      "description": "signed upload URLs (upsert allowed) for <path without extension>-<width>.webp, in the same workspace folder",
      "required": [
       "2400",
       "1600",
       "800"
      ],
      "properties": {
       "800": {
        "type": "string"
       },
       "1600": {
        "type": "string"
       },
       "2400": {
        "type": "string"
       }
      }
     }
    }
   },
   "MediaProcessCallback": {
    "type": "object",
    "description": "The runner reports one processed photo. exifStripped must be the boolean true (422 I-EXIF otherwise: nothing unprocessed is published). A PDF sends only { media, kind: \"document\" } and is answered 422 I-MEDIA-SIZE: the data model has no document flag yet.",
    "required": [
     "media"
    ],
    "properties": {
     "media": {
      "type": "string",
      "format": "uuid"
     },
     "kind": {
      "type": "string",
      "enum": [
       "document"
      ]
     },
     "width": {
      "type": "integer",
      "minimum": 1,
      "description": "of the original after its orientation was applied"
     },
     "height": {
      "type": "integer",
      "minimum": 1
     },
     "exifStripped": {
      "type": "boolean",
      "description": "must be true"
     },
     "bytes": {
      "type": "integer",
      "minimum": 0
     },
     "sizes": {
      "type": "array",
      "items": {
       "type": [
        "integer",
        "string"
       ]
      },
      "maxItems": 10,
      "description": "the widths that were made (accepted, not stored)"
     },
     "skipped": {
      "type": "array",
      "items": {
       "type": [
        "integer",
        "string"
       ]
      },
      "maxItems": 10,
      "description": "widths not made because the original is narrower (accepted, not stored)"
     }
    }
   }
  },
  "responses": {
   "Invalid": {
    "description": "validation failed (I-*/C-* codes)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Problem"
      }
     }
    }
   },
   "Refused": {
    "description": "refused by a wall (S-ROLE, S-OWN-ONLY, S-LOCKED, S-SIGNOFF)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Problem"
      }
     }
    }
   },
   "NotFound": {
    "description": "not found (also any row of another workspace)",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Problem"
      }
     }
    }
   },
   "Unauthorized": {
    "description": "missing or bad token",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Problem"
      }
     }
    }
   },
   "Conflict": {
    "description": "S-SINGLETON: there is already one; edit it",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Problem"
      }
     }
    }
   }
  }
 },
 "paths": {
  "/save": {
   "post": {
    "operationId": "save",
    "summary": "Save a draft version (FR-4, FR-6, FR-7)",
