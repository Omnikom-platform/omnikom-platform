    "security": [
     {
      "runnerSecret": []
     }
    ],
    "parameters": [
     {
      "name": "job",
      "in": "query",
      "required": true,
      "schema": {
       "type": "string",
       "format": "uuid"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "export",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Export"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     },
     "409": {
      "description": "S-JOB-BUSY: another build of this site is running; the runner's queue retries later",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     }
    },
    "description": "The first call moves the job queued -> building and freezes the snapshot; a rerun returns the same snapshot and changes nothing. Media: processed files only; `path` is the widest derivative slot that exists (2400, 1600 or 800), `url` signs that path (1 hour, at most 8 signed at a time), `original_path` is information only."
   }
